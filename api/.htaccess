# Lindungi file konfigurasi rahasia dari unduhan langsung.
<FilesMatch "^(wa-app|wa-official|wa-gateway)\.config\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
